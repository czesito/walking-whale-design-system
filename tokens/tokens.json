{
  "$description": "Walking Whale design tokens — base values (English and any non-zh context). Chinese overrides live in lang-zh.json. Edit tokens here only; dist/ is generated.",
  "color": {
    "$type": "color",
    "pearl": { "$value": "#FBFAF6", "$description": "Primary page background." },
    "white": { "$value": "#FFFFFF", "$description": "Cards, tables, high-clarity surfaces." },
    "mist": { "$value": "#F7F4EE", "$description": "Alternate section wash." },
    "sediment": { "$value": "#E8E0D0", "$description": "Warm paper tone for editorial emphasis panels." },
    "abyss": { "$value": "#0D1F3C", "$description": "Primary brand color: headlines, body text, logo, deep fields." },
    "abyss-raised": { "$value": "#12345C", "$description": "Companion to Abyss for gradients and raised dark surfaces." },
    "tidal": { "$value": "#2E5F7A", "$description": "Secondary brand color: secondary text, supporting blocks, info." },
    "surface": { "$value": "#A8C5D6", "$description": "Light information fills: diagrams, data fields. Never text on light backgrounds." },
    "bone": { "$value": "#C8B99A", "$description": "Decorative lines, dividers, rule accents. Never text on light backgrounds." },
    "biolum": { "$value": "#6DBFA0", "$description": "Sparse signal accent. A fill behind Abyss text, or an accent on dark fields. Never text or a sole indicator on light backgrounds." },
    "biolum-ink": { "$value": "#2F7A60", "$description": "Biolum dark enough for text and focus rings on light backgrounds (DR-011)." },
    "clay-ink": { "$value": "#A05138", "$description": "Fossil-clay warning text." },
    "rust-ink": { "$value": "#A8352A", "$description": "Danger and error text." },
    "slate": { "$value": "#546174", "$description": "Muted neutral text: Abyss at 70% over Pearl, made solid so contrast holds on every light surface including Sediment." },
    "steel": { "$value": "#868F9E", "$description": "Neutral for control borders that must reach 3:1 (Abyss at 50% over White)." },

    "text": {
      "primary": { "$value": "{color.abyss}", "$description": "Headlines and body copy." },
      "secondary": { "$value": "{color.tidal}", "$description": "Secondary copy, supporting labels." },
      "muted": { "$value": "{color.slate}", "$description": "Metadata, captions, helper text." },
      "accent": { "$value": "{color.biolum-ink}", "$description": "Links in running text, success text, zh emphasis on success contexts." },
      "emphasis": { "$value": "{color.tidal}", "$description": "Emphasised words in headlines (en italic, zh weight 700)." },
      "on-dark": { "$value": "{color.pearl}", "$description": "Primary text on Abyss." },
      "on-dark-secondary": { "$value": "{color.surface}", "$description": "Secondary text on Abyss." },
      "on-dark-label": { "$value": "{color.bone}", "$description": "Kickers and labels on Abyss." },
      "on-signal": { "$value": "{color.abyss}", "$description": "Text on a Biolum fill." }
    },
    "background": {
      "page": { "$value": "{color.pearl}" },
      "card": { "$value": "{color.white}" },
      "wash": { "$value": "{color.mist}" },
      "warm": { "$value": "{color.sediment}" },
      "deep": { "$value": "{color.abyss}" },
      "deep-raised": { "$value": "{color.abyss-raised}" },
      "signal": { "$value": "{color.biolum}", "$description": "Reserved for one key call to action per view." }
    },
    "border": {
      "decorative": { "$value": "#C8B99A8C", "$description": "Bone at 55%. Dividers and card outlines; decorative, exempt from contrast." },
      "decorative-soft": { "$value": "#C8B99A4D", "$description": "Bone at 30%." },
      "control": { "$value": "{color.steel}", "$description": "Input, select and checkbox boundaries; must reach 3:1." }
    },
    "focus": { "$value": "{color.biolum-ink}", "$description": "Focus ring on light and dark backgrounds." },

    "index": {
      "done": { "$value": "{color.tidal}", "$description": "Growth layers: completed units on light backgrounds (DR-014)." },
      "current": { "$value": "{color.abyss}", "$description": "Growth layers: the current unit on light backgrounds." },
      "todo": { "$value": "{color.bone}", "$description": "Growth layers: units not reached yet. Below 3:1 by design; state is always also given in text." },
      "on-dark-done": { "$value": "{color.biolum}", "$description": "Growth layers on Abyss: completed units." },
      "on-dark-current": { "$value": "{color.pearl}", "$description": "Growth layers on Abyss: the current unit." },
      "on-dark-todo": { "$value": "{color.tidal}", "$description": "Growth layers on Abyss: units not reached yet. Below 3:1 by design." }
    },
    "status": {
      "success": { "$value": "{color.biolum-ink}" },
      "success-wash": { "$value": "#6DBFA01F" },
      "warning": { "$value": "{color.clay-ink}" },
      "warning-wash": { "$value": "#B06A4F1F" },
      "danger": { "$value": "{color.rust-ink}" },
      "danger-wash": { "$value": "#A8352A1A" },
      "info": { "$value": "{color.tidal}" },
      "info-wash": { "$value": "#A8C5D633" }
    },
    "chart": {
      "1": { "$value": "#20699E", "$description": "Deep tidal." },
      "2": { "$value": "#2E8C68", "$description": "Deep biolum." },
      "3": { "$value": "#B4552F", "$description": "Clay." },
      "4": { "$value": "#4B559E", "$description": "Deep-current indigo." },
      "other": { "$value": "#8A8578", "$description": "Neutral fold for a fifth series and beyond. Never a fifth hue." },
      "grid": { "$value": "#C8B99A59", "$description": "Bone at 35%." },
      "label": { "$value": "{color.slate}", "$description": "Tick and axis labels are text and must reach 4.5:1." }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Cormorant Garamond", "Noto Serif TC", "Georgia", "Times New Roman", "serif"] },
      "body": { "$value": ["Source Serif 4", "Noto Serif TC", "Georgia", "serif"] },
      "ui": { "$value": ["Inter", "Noto Sans TC", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": { "$value": ["IBM Plex Mono", "Noto Sans TC", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] },
      "kicker": { "$value": "{font.family.mono}", "$description": "en kickers are mono uppercase; zh switches to the UI face." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "display": { "$value": 500 },
      "heading": { "$value": 600 },
      "emphasis": { "$value": 500, "$description": "en emphasis is the italic cut at display weight; zh overrides to 700." }
    },
    "style": {
      "emphasis": { "$value": "italic", "$description": "zh overrides to normal (DR-007)." }
    },
    "size": {
      "$type": "dimension",
      "hero": { "$value": "clamp(2.6rem, 7vw, 4.6rem)" },
      "h1": { "$value": "clamp(2rem, 5vw, 3rem)" },
      "h2": { "$value": "clamp(1.6rem, 4vw, 2.2rem)" },
      "h3": { "$value": "1.5rem" },
      "h4": { "$value": "1.25rem" },
      "lede": { "$value": "clamp(1.0625rem, 2vw, 1.25rem)", "$description": "Introductory paragraph under a headline. Body face, upright, muted." },
      "body": { "$value": "1.0625rem", "$description": "17px editorial base." },
      "ui": { "$value": "0.9375rem", "$description": "15px controls and navigation." },
      "sm": { "$value": "0.8125rem", "$description": "13px helper text and captions." },
      "kicker": { "$value": "0.75rem", "$description": "12px mono uppercase." }
    },
    "transform": {
      "kicker": { "$value": "uppercase", "$description": "zh overrides to none; case has no meaning in CJK." }
    }
  },

  "line-height": {
    "$type": "number",
    "display": { "$value": 1.0 },
    "heading": { "$value": 1.15 },
    "lede": { "$value": 1.35 },
    "body": { "$value": 1.62 },
    "ui": { "$value": 1.4 }
  },

  "letter-spacing": {
    "$type": "dimension",
    "display": { "$value": "-0.03em" },
    "heading": { "$value": "-0.01em" },
    "body": { "$value": "0em" },
    "ui": { "$value": "0em" },
    "kicker": { "$value": "0.1em" },
    "label": { "$value": "0.08em" }
  },

  "layout": {
    "$type": "dimension",
    "measure-body": { "$value": "68ch", "$description": "Max line length for running text." },
    "container": { "$value": "1180px" },
    "container-narrow": { "$value": "940px" },
    "section-gap": { "$value": "56px" }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "22px" },
    "6": { "$value": "28px" },
    "7": { "$value": "36px" },
    "8": { "$value": "48px" },
    "9": { "$value": "64px" },
    "10": { "$value": "88px" }
  },

  "radius": {
    "$type": "dimension",
    "xs": { "$value": "2px", "$description": "Default corner for cards, buttons, inputs and plates (DR-013 B1)." },
    "sm": { "$value": "4px", "$description": "Images and media frames." },
    "md": { "$value": "8px", "$description": "Floating surfaces: drawer, toast, menus." },
    "lg": { "$value": "12px", "$description": "Rare large panels. Avoid in B1 layouts." },
    "pill": { "$value": "999px", "$description": "Chips and status badges only (DR-013)." }
  },

  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "color": "#0D1F3C0D", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" } },
    "md": { "$value": { "color": "#0D1F3C12", "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px" } },
    "lg": { "$value": { "color": "#0D1F3C17", "offsetX": "0px", "offsetY": "16px", "blur": "45px", "spread": "0px" } }
  },

  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
    "duration": {
      "$type": "duration",
      "instant": { "$value": "150ms", "$description": "Buttons, hovers, simple interactions." },
      "base": { "$value": "220ms", "$description": "Default transitions." },
      "reveal": { "$value": "600ms", "$description": "Section entrances, horizontal reveals." },
      "rise": { "$value": "650ms", "$description": "Fade and rise." }
    },
    "distance": {
      "$type": "dimension",
      "rise": { "$value": "14px" }
    }
  }
}
